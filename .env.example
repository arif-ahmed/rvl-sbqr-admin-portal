# Target for the Vite dev/preview server proxy (SBQR.Api from the
# rvl-secure-bqr-manager repo, `dotnet run` defaults to http://localhost:5001).
# Production does NOT use this — vercel.json rewrites handle routing there.
SBQR_API_URL=http://localhost:5001

# Dev server port (5173 is taken by rvl-sbqr-app-emulator in the workspace).
PORT=5174
